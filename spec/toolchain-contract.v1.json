{
  "schema_version": "2.0.0",
  "contract_id": "aco-workshop-toolchain-v2",
  "tracks": {
    "local": {
      "required": ["PowerShell", ".NET 10 SDK", "Node.js 24", "npm"],
      "doctor": "ops/doctor.ps1 -Track Local",
      "docker_required": false
    },
    "azure": {
      "required": ["local track", "Azure CLI", "Azure Bicep CLI", "ACR remote build"],
      "doctor": "ops/doctor.ps1 -Track Azure",
      "docker_required": false
    },
    "foundry": {
      "required": ["azure track", "Microsoft Foundry project", "compatible model deployment", "data-plane access"],
      "doctor": "ops/doctor.ps1 -Track Foundry"
    }
  },
  "commands": {
    "setup": "npm run setup",
    "validate": "npm run validate",
    "sample": "ops/start-workshop.ps1 -Mode Sample",
    "live": "ops/start-workshop.ps1 -Mode Live",
    "foundation": "ops/workshop-infra.ps1",
    "image": "ops/workshop-image.ps1",
    "application": "ops/workshop-app.ps1",
    "smoke": "ops/workshop-smoke.ps1",
    "pre_demo": "ops/pre-demo.ps1",
    "cleanup": "ops/workshop-cleanup.ps1"
  },
  "policy": "Scripts install nothing automatically, never change the global Azure CLI subscription, and stage Azure writes behind explicit commands and reviewed what-if artifacts."
}
