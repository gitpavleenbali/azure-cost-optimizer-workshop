    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.45.0",
    "mermaid": "11.17.2",
    "mssql": "^12.7.2",
    "multer": "2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
